# Copy to .env and fill in. Never commit .env.
# pid_graph has its own Neo4j container (scripts\setup_neo4j.ps1): neo4j-pidgraph, bolt 7688, browser 7475.
# Do not point this at another project's database (kg_suppression uses neo4j-kg on 7687).
NEO4J_CONTAINER=neo4j-pidgraph
NEO4J_URI=bolt://localhost:7688
NEO4J_HTTP_PORT=7475
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
